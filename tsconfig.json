{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "target": "esnext",
    "verbatimModuleSyntax": true
  },
  "exclude": ["**/*.config.js", "./dist/**/*"],
  "include": ["**/*.js", "**/*.ts"]
}
